# Copy to .env, then load it before starting the server:
#   set -a; . ./.env; set +a; node server.mjs

# Demo mode simulates every model and MCP call and makes no network requests.
# Uncomment to try the full workflow without a gateway key.
# AGENT_FACTORY_DEMO=1

# Live mode: an OpenAI Responses-compatible gateway.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=replace-me
AGENT_FACTORY_MODEL=gpt-4.1-mini

# Optional local guard rails.
# AGENT_FACTORY_TOKEN_BUDGET=100000
# AGENT_FACTORY_TIMEOUT_MS=90000
# AGENT_FACTORY_DATA_DIR=./data
# AGENT_FACTORY_ALLOWED_HOSTS=
# PORT=8000
# HOST=127.0.0.1
